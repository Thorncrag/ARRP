{
  "schemaVersion": 1,
  "agentId": "run-coordinator-bot",
  "enabled": false,
  "repository": "Thorncrag/ARRP",
  "schedule": {
    "mode": "disabled",
    "intendedCron": "17 4 * * *",
    "description": "Repository source only during P2; no scheduler is installed"
  },
  "activation": {
    "allowed": [
      "fixture",
      "manual-dry-run"
    ],
    "cutoverRequiredForCanonicalRun": true
  },
  "runtime": {
    "entrypoint": "scripts/arrp_nightly.py",
    "repositoryPath": "/Users/benjaminsmith/Automation Workspaces/ARRP",
    "stateDirectory": "~/Library/Application Support/ARRP",
    "lastSuccessPath": "~/Library/Application Support/ARRP/last-success.json",
    "oneScheduler": true,
    "oneOperatingSystemLock": true,
    "cloudWorkflowAuthority": false
  },
  "outputs": {
    "root": "<run-dir>",
    "status": "<run-dir>/status.json",
    "stageDirectory": "<run-dir>/stages",
    "queue": "<run-dir>/queue.json",
    "route": "<run-dir>/route.json",
    "context": "<run-dir>/context",
    "elimJsonl": "<run-dir>/elim.jsonl",
    "elimResult": "<run-dir>/elim-result.json"
  },
  "usageGate": {
    "hardReservePercent": 15,
    "maximumSelectedUnits": 1,
    "unavailableAction": "skip-elim"
  },
  "llmRouting": {
    "defaultProfile": "substantive",
    "profiles": {
      "read-heavy-triage": {
        "model": "gpt-5.6-terra",
        "reasoningEffort": "high",
        "fullContext": false,
        "eligibleQueueClasses": [
          "monitoring",
          "sources",
          "intake"
        ]
      },
      "substantive": {
        "model": "gpt-5.6-sol",
        "reasoningEffort": "xhigh",
        "fullContext": false,
        "eligibleQueueClasses": [
          "integrity",
          "audit",
          "foundation",
          "candidate",
          "legal",
          "gap-stewardship",
          "governance-discovery"
        ]
      },
      "comprehensive": {
        "model": "gpt-5.6-sol",
        "reasoningEffort": "xhigh",
        "fullContext": true,
        "eligibleQueueClasses": [
          "comprehensive-review"
        ]
      }
    }
  },
  "elim": {
    "freshEachRun": true,
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "shellNetwork": false,
    "webSearch": false,
    "plugins": false,
    "mcpServers": false,
    "subagents": false,
    "credentials": false,
    "gitMutation": false,
    "strictResultSchema": "framework/project/automation/schemas/elim-work-unit-result.schema.json",
    "allowedWriteClass": "selected-ordinary-paths-only",
    "protectedWriteAction": "preserve-and-fail-closed"
  },
  "reviewEpoch": {
    "intervalDays": 14
  },
  "governanceDiscovery": {
    "enabled": true,
    "mode": "Project governance review and discovery",
    "ordinarySelectionPolicy": "after-ordinary-queue-clears",
    "minimumIntervalHours": 168
  },
  "gapStewardship": {
    "statePath": "<run-dir>/elim-gap-obligations.json",
    "stateRole": "replaceable-cache",
    "durableAuthority": "framework/records/automation/elim-run-log.md#machine-readable-discovery-markers",
    "reconstructBeforeQueueBuild": true,
    "maximumObligations": 512,
    "closureProofRequired": true,
    "outsideContributionExactRevisionRequired": true
  },
  "stages": [
    {
      "id": "case-monitor-bot",
      "command": "python3 scripts/check_case_updates.py --apply <runner-supplied exact output arguments>",
      "output": "<run-dir>/stages/case-monitor-bot",
      "due": {
        "kind": "interval",
        "hours": 24
      },
      "failureClass": "blocking"
    },
    {
      "id": "presidential-directives-bot",
      "command": "python3 scripts/check_presidential_directives.py --apply <runner-supplied exact output arguments>",
      "output": "<run-dir>/stages/presidential-directives-bot",
      "due": {
        "kind": "interval",
        "hours": 24
      },
      "failureClass": "blocking"
    },
    {
      "id": "source-checker-bot",
      "command": "python3 scripts/check_source_urls.py <runner-supplied prior/report arguments>",
      "output": "<run-dir>/stages/source-checker-bot",
      "due": {
        "kind": "interval",
        "hours": 168
      },
      "failureClass": "degraded"
    },
    {
      "id": "public-intake",
      "command": "python3 scripts/collect_public_intake.py <runner-supplied prior/ledger/output arguments>",
      "output": "<run-dir>/stages/public-intake",
      "due": {
        "kind": "always"
      },
      "failureClass": "degraded"
    },
    {
      "id": "project-console-progress-bot",
      "command": "python3 scripts/build_project_console_progress.py --config framework/project/interfaces/project-console-progress.json --registry inventory/github_issue_registry.csv --output <run-dir>/progress",
      "output": "<run-dir>/progress",
      "due": {
        "kind": "interval",
        "hours": 24
      },
      "failureClass": "blocking"
    },
    {
      "id": "project-integrity-bot",
      "command": "python3 scripts/audit_project_consistency.py --json-output <run-dir>/integrity.json --markdown-output framework/records/status/project-integrity-report.md --exit-zero-on-findings",
      "output": "<run-dir>/integrity.json",
      "due": {
        "kind": "always"
      },
      "failureClass": "blocking"
    }
  ]
}
