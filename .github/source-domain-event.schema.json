{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Thorncrag/ARRP/blob/main/.github/source-domain-event.schema.json",
  "title": "ARRP source-domain event",
  "description": "A minimized, immutable provenance record for a deterministic source watcher proposal and its separately verified human-acceptance boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "kind",
    "event_id",
    "idempotency_key",
    "state",
    "agent_id",
    "chain_id",
    "run_id",
    "trigger",
    "source_revision",
    "proposal",
    "output_hashes",
    "affected_records",
    "summary",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_uri": {
      "const": ".github/source-domain-event.schema.json"
    },
    "kind": {
      "const": "source-domain-event"
    },
    "event_id": {
      "type": "string",
      "pattern": "^SDE-[A-F0-9]{24}$"
    },
    "idempotency_key": {
      "$ref": "#/$defs/hash"
    },
    "state": {
      "enum": [
        "proposed",
        "accepted"
      ]
    },
    "agent_id": {
      "enum": [
        "case-monitor-bot",
        "presidential-directives-bot",
        "source-checker-bot"
      ]
    },
    "chain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "trigger": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "source_revision": {
      "$ref": "#/$defs/revision"
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_ref",
        "head_ref",
        "pull_request_number",
        "pull_request_url",
        "proposal_revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_ref": {
          "const": "main"
        },
        "head_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pull_request_number": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"
        },
        "proposal_revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_report",
        "proposal_diff",
        "files"
      ],
      "properties": {
        "semantic_report": {
          "$ref": "#/$defs/hash"
        },
        "proposal_diff": {
          "$ref": "#/$defs/hash"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 300,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(inventory/(sources\\.csv|sources-pending\\.csv|presidential-directives\\.csv)|framework/records/status/source-checker-report\\.md|research/horizon-source-records/HOR-[0-9]{3}-source-development\\.md|areas/[A-Z]+/research/[A-Z]+-[0-9]{3}-source-development\\.md)$"
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20000000
              }
            }
          }
        }
      }
    },
    "affected_records": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_type",
          "record_id"
        ],
        "properties": {
          "record_type": {
            "enum": [
              "source",
              "presidential-directive",
              "issue",
              "candidate"
            ]
          },
          "record_id": {
            "type": "string",
            "pattern": "^(SRC-[0-9]{4,}|[A-Z]+-[0-9]{3}|HOR-[0-9]{3}|[A-Za-z0-9][A-Za-z0-9._-]{2,100})$"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "affected_record_count",
        "counts"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 _./:-]*$"
        },
        "affected_record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "counts": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          }
        }
      }
    },
    "acceptance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary",
            "pull_request_number",
            "pull_request_url",
            "merged_at",
            "merged_by",
            "merged_by_type",
            "merge_commit"
          ],
          "properties": {
            "boundary": {
              "const": "human-pull-request-merge"
            },
            "pull_request_number": {
              "type": "integer",
              "minimum": 1
            },
            "pull_request_url": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"
            },
            "merged_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "merged_by": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
            },
            "merged_by_type": {
              "const": "User"
            },
            "merge_commit": {
              "$ref": "#/$defs/revision"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "properties": {
          "acceptance": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "acceptance": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
