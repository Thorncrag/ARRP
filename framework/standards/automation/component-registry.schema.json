{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arrp.org/schemas/component-registry.schema.json",
  "title": "ARRP Component Registry Stage 2",
  "description": "Closed Stage 2 component inventory. Semantic validation is performed by scripts/component_registry.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "registry_id",
    "registry_revision",
    "validation",
    "authority_digest_model",
    "terminology",
    "implementation_enums",
    "directory_scopes",
    "components",
    "component_lifecycles",
    "component_authorities",
    "relationships",
    "migrations_and_aliases",
    "provenance_events",
    "routing",
    "supporting_artifact_rules",
    "repository_coverage"
  ],
  "properties": {
    "$schema": {
      "const": "standards/automation/component-registry.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "registry_id": {
      "const": "COMPONENT-REGISTRY"
    },
    "registry_revision": {
      "const": 2
    },
    "validation": {
      "$ref": "#/$defs/validationEnvelope"
    },
    "authority_digest_model": {
      "$ref": "#/$defs/authorityDigestModel"
    },
    "terminology": {
      "$ref": "#/$defs/terminologyNamespace"
    },
    "implementation_enums": {
      "$ref": "#/$defs/implementationEnums"
    },
    "directory_scopes": {
      "$ref": "#/$defs/directoryScopeNamespace"
    },
    "components": {
      "$ref": "#/$defs/componentNamespace"
    },
    "component_lifecycles": {
      "type": "object"
    },
    "component_authorities": {
      "type": "object"
    },
    "relationships": {
      "$ref": "#/$defs/entriesNamespace"
    },
    "migrations_and_aliases": {
      "$ref": "#/$defs/entriesNamespace"
    },
    "provenance_events": {
      "$ref": "#/$defs/entriesNamespace"
    },
    "routing": {
      "type": "object"
    },
    "supporting_artifact_rules": {
      "$ref": "#/$defs/entriesNamespace"
    },
    "repository_coverage": {
      "type": "object"
    }
  },
  "$defs": {
    "authorityDigestModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol",
        "generation",
        "hash_algorithm",
        "canonicalization",
        "domain",
        "source_revision_admission_predicate",
        "normalizations"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "protocol": {
          "const": "component_registry_stage2_authority_digest_v1"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "utf8_sorted_key_compact_json_v1"
        },
        "domain": {
          "const": "arrp.component_registry.stage2.authority_digest"
        },
        "source_revision_admission_predicate": {
          "const": "component_registry_source_revision_admission_v1"
        },
        "normalizations": {
          "const": [
            {
              "json_pointer_pattern": "/validation/repository_base_revision",
              "condition": "always",
              "replacement": "__AUTHORITY_CURRENTNESS_REPOSITORY_BASE_REVISION__"
            },
            {
              "json_pointer_pattern": "/components/entries/*/canonical_source/source_binding/sha256",
              "condition": "binding_basis_equals_content_digest",
              "replacement": "__AUTHORITY_CURRENTNESS_CONTENT_SHA256__"
            }
          ]
        }
      }
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "componentNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "entries": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "stable_id",
              "display_name",
              "classification",
              "canonical_source",
              "owner",
              "information_handling",
              "retention",
              "supporting_artifacts",
              "record_refs"
            ],
            "properties": {
              "classification": {
                "type": "object",
                "required": [
                  "component_class",
                  "roles",
                  "capabilities",
                  "attributes"
                ],
                "properties": {
                  "component_class": {
                    "$ref": "#/$defs/nonemptyString"
                  },
                  "component_type": {
                    "$ref": "#/$defs/nonemptyString"
                  },
                  "roles": {
                    "$ref": "#/$defs/stringArray"
                  },
                  "capabilities": {
                    "$ref": "#/$defs/stringArray"
                  },
                  "attributes": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              },
              "repository_controls": {
                "$ref": "#/$defs/repositoryControls"
              }
            }
          }
        }
      }
    },
    "repositoryControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_codeowners"
      ],
      "properties": {
        "github_codeowners": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "owners"
              ],
              "properties": {
                "mode": {
                  "const": "direct"
                },
                "owners": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "inherit",
                    "none"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "directoryScopeNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "entries": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "repository_controls"
            ],
            "properties": {
              "repository_controls": {
                "$ref": "#/$defs/repositoryControls"
              }
            }
          }
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "componentRegistryActivationReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verification_type",
        "verification_state",
        "complete",
        "issuer",
        "repository",
        "default_branch",
        "registry_id",
        "registry_path",
        "registry_revision",
        "registry_sha256",
        "governance_change_id",
        "implementation_contract_id",
        "approval_sha256",
        "candidate_registry_sha256",
        "bounded_diff_sha256",
        "owner_review_reference",
        "pull_request_number",
        "approval_evidence_type",
        "approved_head_revision",
        "approved_by",
        "merged_by",
        "merged_at",
        "merge_commit_revision",
        "required_checks_state",
        "required_checks_revision",
        "remote_main_revision",
        "remote_registry_sha256",
        "verified_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "verification_type": {
          "const": "component_registry_activation_readback"
        },
        "verification_state": {
          "const": "authenticated_owner_readback"
        },
        "complete": {
          "const": true
        },
        "issuer": {
          "const": "component_registry_activation_finalizer"
        },
        "repository": {
          "const": "Thorncrag/ARRP"
        },
        "default_branch": {
          "const": "main"
        },
        "registry_id": {
          "const": "COMPONENT-REGISTRY"
        },
        "registry_path": {
          "const": "framework/component-registry.json"
        },
        "registry_revision": {
          "type": "integer",
          "minimum": 1
        },
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "governance_change_id": {
          "type": "string",
          "pattern": "^GOV-[0-9]{4}-[0-9]{3,}$"
        },
        "implementation_contract_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "approval_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bounded_diff_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner_review_reference": {
          "type": "string",
          "pattern": "^github-review:Thorncrag/ARRP#([1-9][0-9]*)$"
        },
        "pull_request_number": {
          "type": "integer",
          "minimum": 1
        },
        "approval_evidence_type": {
          "const": "github_owner_manual_merge"
        },
        "approved_head_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "approved_by": {
          "const": "@Thorncrag"
        },
        "merged_by": {
          "const": "Thorncrag"
        },
        "merged_at": {
          "$ref": "#/$defs/timestamp"
        },
        "merge_commit_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "required_checks_state": {
          "const": "success"
        },
        "required_checks_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "remote_main_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "remote_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verified_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "stage2AuthorityRequiredCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "context",
        "app_id",
        "run_id",
        "completed_at"
      ],
      "properties": {
        "evidence_type": {
          "enum": [
            "check_run",
            "commit_status"
          ]
        },
        "context": {
          "$ref": "#/$defs/nonemptyString"
        },
        "app_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "stage2AuthorityMergeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request_number",
        "pull_request_id",
        "pull_request_node_id",
        "base_revision",
        "reviewed_head",
        "reviewed_tree",
        "merge_commit",
        "merge_tree",
        "merged_by",
        "merged_by_id",
        "merged_by_node_id",
        "merged_at",
        "required_checks"
      ],
      "properties": {
        "pull_request_number": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request_id": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request_node_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "base_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "reviewed_head": {
          "$ref": "#/$defs/gitRevision"
        },
        "reviewed_tree": {
          "$ref": "#/$defs/gitRevision"
        },
        "merge_commit": {
          "$ref": "#/$defs/gitRevision"
        },
        "merge_tree": {
          "$ref": "#/$defs/gitRevision"
        },
        "merged_by": {
          "const": "Thorncrag"
        },
        "merged_by_id": {
          "type": "integer",
          "minimum": 1
        },
        "merged_by_node_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "merged_at": {
          "$ref": "#/$defs/timestamp"
        },
        "approved_by": {
          "const": "@Thorncrag"
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stage2AuthorityRequiredCheck"
          }
        }
      }
    },
    "componentRegistryStage2AuthorityReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verification_type",
        "issuer",
        "repository",
        "registry_id",
        "registry_revision",
        "protocol",
        "generation",
        "authority_sha256",
        "adopted_registry_sha256",
        "correction_registry_sha256",
        "canonical_revision",
        "issuance_revision",
        "original_design",
        "correction_design",
        "validation_mode",
        "source_revision_admission_predicate",
        "original_adoption_evidence",
        "correction_evidence",
        "canonical_history"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "verification_type": {
          "const": "component_registry_stage2_authority_readback"
        },
        "issuer": {
          "const": "component_registry_activation_finalizer"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "node_id",
            "full_name",
            "default_branch"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "node_id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "full_name": {
              "const": "Thorncrag/ARRP"
            },
            "default_branch": {
              "const": "main"
            }
          }
        },
        "registry_id": {
          "const": "COMPONENT-REGISTRY"
        },
        "registry_revision": {
          "const": 2
        },
        "protocol": {
          "const": "component_registry_stage2_authority_digest_v1"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "authority_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adopted_registry_sha256": {
          "const": "cfdcc68500fca953863aa34b77e7b5d687f13bda2f0ad63214373111959056e7"
        },
        "correction_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_revision": {
          "const": "c1c0b8ecbdcc1b4c7994b33f1a1cc72d61a20214"
        },
        "issuance_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "original_design": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_id",
            "design_revision"
          ],
          "properties": {
            "design_id": {
              "const": "COMPONENT-REGISTRY-2026-002-STAGE2-IMPLEMENTATION-PR"
            },
            "design_revision": {
              "const": "sha256:16c7801b08397a640829bcb9141de7482c68ea9d9aa793fba0d1080fea9d95b0"
            }
          }
        },
        "correction_design": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_id",
            "design_revision"
          ],
          "properties": {
            "design_id": {
              "const": "COMPONENT-REGISTRY-2026-002-AUTHORITY-CURRENTNESS-SEPARATION-CLOSEOUT"
            },
            "design_revision": {
              "const": "sha256:70f48e4a6668e1cdee965c0777cc52056469b954df5abb34e95642e095fcfca5"
            }
          }
        },
        "validation_mode": {
          "const": "online_governed_eligibility"
        },
        "source_revision_admission_predicate": {
          "const": "component_registry_source_revision_admission_v1"
        },
        "original_adoption_evidence": {
          "$ref": "#/$defs/stage2AuthorityMergeEvidence"
        },
        "correction_evidence": {
          "allOf": [
            {
              "$ref": "#/$defs/stage2AuthorityMergeEvidence"
            },
            {
              "type": "object",
              "required": [
                "approved_by"
              ],
              "properties": {
                "approved_by": {
                  "const": "@Thorncrag"
                }
              }
            }
          ]
        },
        "canonical_history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol_epoch_revision",
            "epoch_revision",
            "observed_remote_revision",
            "observed_remote_commit_time",
            "merge_commits"
          ],
          "properties": {
            "protocol_epoch_revision": {
              "$ref": "#/$defs/gitRevision"
            },
            "epoch_revision": {
              "$ref": "#/$defs/gitRevision"
            },
            "observed_remote_revision": {
              "$ref": "#/$defs/gitRevision"
            },
            "observed_remote_commit_time": {
              "$ref": "#/$defs/timestamp"
            },
            "merge_commits": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/gitRevision"
              }
            }
          }
        }
      }
    },
    "componentRegistryStage2AdoptionReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verification_type",
        "issuer",
        "registry_id",
        "registry_revision",
        "registry_sha256",
        "canonical_revision",
        "design_id",
        "design_revision",
        "validation_mode",
        "adoption_evidence"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "verification_type": {
          "const": "component_registry_stage2_adoption_readback"
        },
        "issuer": {
          "const": "component_registry_activation_finalizer"
        },
        "registry_id": {
          "const": "COMPONENT-REGISTRY"
        },
        "registry_revision": {
          "const": 2
        },
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "design_id": {
          "const": "COMPONENT-REGISTRY-2026-002-STAGE2-IMPLEMENTATION-PR"
        },
        "design_revision": {
          "const": "sha256:16c7801b08397a640829bcb9141de7482c68ea9d9aa793fba0d1080fea9d95b0"
        },
        "validation_mode": {
          "const": "live_authority_validation"
        },
        "adoption_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adopted_by",
            "adopted_at",
            "pull_request",
            "base_revision",
            "reviewed_head",
            "merge_commit",
            "checks_revision",
            "checks_state"
          ],
          "properties": {
            "adopted_by": {
              "const": "@Thorncrag"
            },
            "adopted_at": {
              "$ref": "#/$defs/timestamp"
            },
            "pull_request": {
              "type": "string",
              "pattern": "^github-review:Thorncrag/ARRP#[0-9]+$"
            },
            "base_revision": {
              "$ref": "#/$defs/gitRevision"
            },
            "reviewed_head": {
              "$ref": "#/$defs/gitRevision"
            },
            "merge_commit": {
              "$ref": "#/$defs/gitRevision"
            },
            "checks_revision": {
              "$ref": "#/$defs/gitRevision"
            },
            "checks_state": {
              "const": "success"
            }
          }
        }
      }
    },
    "entriesNamespace": {
      "type": "object",
      "required": [
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "validationEnvelope": {
      "type": "object",
      "required": [
        "mode",
        "design_id",
        "design_revision",
        "repository_base_revision",
        "live_authority"
      ],
      "properties": {
        "mode": {
          "enum": [
            "proposed_revision_validation",
            "adopted_configuration_validation",
            "live_authority_validation"
          ]
        },
        "design_id": {
          "const": "COMPONENT-REGISTRY-2026-002-STAGE2-IMPLEMENTATION-PR"
        },
        "design_revision": {
          "const": "sha256:16c7801b08397a640829bcb9141de7482c68ea9d9aa793fba0d1080fea9d95b0"
        },
        "repository_base_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "live_authority": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "terminologyNamespace": {
      "type": "object",
      "required": [
        "schema_version",
        "adopted",
        "record_set_sha256",
        "canonicalization",
        "order",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "adopted": {
          "const": true
        },
        "record_set_sha256": {
          "const": "12da8a526f4182ab366f518abcd879720bf6705935205b09566fca0f87642dae"
        },
        "canonicalization": {
          "type": "object"
        },
        "order": {
          "type": "array",
          "minItems": 69,
          "maxItems": 69,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "entries": {
          "type": "object",
          "minProperties": 69,
          "maxProperties": 69
        }
      },
      "additionalProperties": false
    },
    "implementationEnums": {
      "type": "object",
      "required": [
        "schema_version",
        "owner_decision",
        "component_classes",
        "component_types",
        "roles",
        "capabilities",
        "operational_statuses",
        "relationship_types",
        "retention_bases",
        "change_modes",
        "custody_values",
        "information_classifications",
        "disclosure_rules",
        "disclosure_boundaries",
        "source_binding_bases",
        "verification_methods",
