{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arrp.org/schemas/component-registry.schema.json",
  "title": "ARRP Component Registry Stage 2",
  "description": "Closed Stage 2 component inventory. Semantic validation is performed by scripts/component_registry.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "registry_id",
    "registry_revision",
    "validation",
    "terminology",
    "implementation_enums",
    "directory_scopes",
    "components",
    "component_lifecycles",
    "component_authorities",
    "relationships",
    "migrations_and_aliases",
    "provenance_events",
    "routing",
    "supporting_artifact_rules",
    "repository_coverage"
  ],
  "properties": {
    "$schema": {
      "const": "standards/automation/component-registry.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "registry_id": {
      "const": "COMPONENT-REGISTRY"
    },
    "registry_revision": {
      "const": 2
    },
    "validation": {
      "$ref": "#/$defs/validationEnvelope"
    },
    "terminology": {
      "$ref": "#/$defs/terminologyNamespace"
    },
    "implementation_enums": {
      "$ref": "#/$defs/implementationEnums"
    },
    "directory_scopes": {
      "$ref": "#/$defs/entriesNamespace"
    },
    "components": {
      "$ref": "#/$defs/componentNamespace"
    },
    "component_lifecycles": {
      "type": "object"
    },
    "component_authorities": {
      "type": "object"
    },
    "relationships": {
      "$ref": "#/$defs/entriesNamespace"
    },
    "migrations_and_aliases": {
      "$ref": "#/$defs/entriesNamespace"
    },
    "provenance_events": {
      "$ref": "#/$defs/entriesNamespace"
    },
    "routing": {
      "type": "object"
    },
    "supporting_artifact_rules": {
      "$ref": "#/$defs/entriesNamespace"
    },
    "repository_coverage": {
      "type": "object"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "componentNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "entries": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "stable_id",
              "display_name",
              "classification",
              "canonical_source",
              "owner",
              "information_handling",
              "retention",
              "supporting_artifacts",
              "record_refs"
            ],
            "properties": {
              "classification": {
                "type": "object",
                "required": [
                  "component_class",
                  "roles",
                  "capabilities",
                  "attributes"
                ],
                "properties": {
                  "component_class": {
                    "$ref": "#/$defs/nonemptyString"
                  },
                  "component_type": {
                    "$ref": "#/$defs/nonemptyString"
                  },
                  "roles": {
                    "$ref": "#/$defs/stringArray"
                  },
                  "capabilities": {
                    "$ref": "#/$defs/stringArray"
                  },
                  "attributes": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "componentRegistryActivationReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verification_type",
        "verification_state",
        "complete",
        "issuer",
        "repository",
        "default_branch",
        "registry_id",
        "registry_path",
        "registry_revision",
        "registry_sha256",
        "governance_change_id",
        "implementation_contract_id",
        "approval_sha256",
        "candidate_registry_sha256",
        "bounded_diff_sha256",
        "owner_review_reference",
        "pull_request_number",
        "approval_evidence_type",
        "approved_head_revision",
        "approved_by",
        "merged_by",
        "merged_at",
        "merge_commit_revision",
        "required_checks_state",
        "required_checks_revision",
        "remote_main_revision",
        "remote_registry_sha256",
        "verified_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "verification_type": {
          "const": "component_registry_activation_readback"
        },
        "verification_state": {
          "const": "authenticated_owner_readback"
        },
        "complete": {
          "const": true
        },
        "issuer": {
          "const": "component_registry_activation_finalizer"
        },
        "repository": {
          "const": "Thorncrag/ARRP"
        },
        "default_branch": {
          "const": "main"
        },
        "registry_id": {
          "const": "COMPONENT-REGISTRY"
        },
        "registry_path": {
          "const": "framework/component-registry.json"
        },
        "registry_revision": {
          "type": "integer",
          "minimum": 1
        },
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "governance_change_id": {
          "type": "string",
          "pattern": "^GOV-[0-9]{4}-[0-9]{3,}$"
        },
        "implementation_contract_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "approval_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bounded_diff_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner_review_reference": {
          "type": "string",
          "pattern": "^github-review:Thorncrag/ARRP#([1-9][0-9]*)$"
        },
        "pull_request_number": {
          "type": "integer",
          "minimum": 1
        },
        "approval_evidence_type": {
          "const": "github_owner_manual_merge"
        },
        "approved_head_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "approved_by": {
          "const": "@Thorncrag"
        },
        "merged_by": {
          "const": "Thorncrag"
        },
        "merged_at": {
          "$ref": "#/$defs/timestamp"
        },
        "merge_commit_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "required_checks_state": {
          "const": "success"
        },
        "required_checks_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "remote_main_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "remote_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verified_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "componentRegistryStage2AdoptionReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verification_type",
        "issuer",
        "registry_id",
        "registry_revision",
        "registry_sha256",
        "canonical_revision",
        "design_id",
        "design_revision",
        "validation_mode",
        "adoption_evidence"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "verification_type": {
          "const": "component_registry_stage2_adoption_readback"
        },
        "issuer": {
          "const": "component_registry_activation_finalizer"
        },
        "registry_id": {
          "const": "COMPONENT-REGISTRY"
        },
        "registry_revision": {
          "const": 2
        },
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "design_id": {
          "const": "COMPONENT-REGISTRY-2026-002-STAGE2-IMPLEMENTATION-PR"
        },
        "design_revision": {
          "const": "sha256:16c7801b08397a640829bcb9141de7482c68ea9d9aa793fba0d1080fea9d95b0"
        },
        "validation_mode": {
          "const": "live_authority_validation"
        },
        "adoption_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adopted_by",
            "adopted_at",
            "pull_request",
            "reviewed_head",
            "merge_commit",
            "checks_revision",
            "checks_state"
          ],
          "properties": {
            "adopted_by": {
              "const": "@Thorncrag"
            },
            "adopted_at": {
              "$ref": "#/$defs/timestamp"
            },
            "pull_request": {
              "type": "string",
              "pattern": "^github-review:Thorncrag/ARRP#[0-9]+$"
            },
            "reviewed_head": {
              "$ref": "#/$defs/gitRevision"
            },
            "merge_commit": {
              "$ref": "#/$defs/gitRevision"
            },
            "checks_revision": {
              "$ref": "#/$defs/gitRevision"
            },
            "checks_state": {
              "const": "success"
            }
          }
        }
      }
    },
    "entriesNamespace": {
      "type": "object",
      "required": [
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "validationEnvelope": {
      "type": "object",
      "required": [
        "mode",
        "design_id",
        "design_revision",
        "repository_base_revision",
        "live_authority"
      ],
      "properties": {
        "mode": {
          "enum": [
            "proposed_revision_validation",
            "adopted_configuration_validation",
            "live_authority_validation"
          ]
        },
        "design_id": {
          "const": "COMPONENT-REGISTRY-2026-002-STAGE2-IMPLEMENTATION-PR"
        },
        "design_revision": {
          "const": "sha256:16c7801b08397a640829bcb9141de7482c68ea9d9aa793fba0d1080fea9d95b0"
        },
        "repository_base_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "live_authority": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "terminologyNamespace": {
      "type": "object",
      "required": [
        "schema_version",
        "adopted",
        "record_set_sha256",
        "canonicalization",
        "order",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "adopted": {
          "const": true
        },
        "record_set_sha256": {
          "const": "12da8a526f4182ab366f518abcd879720bf6705935205b09566fca0f87642dae"
        },
        "canonicalization": {
          "type": "object"
        },
        "order": {
          "type": "array",
          "minItems": 69,
          "maxItems": 69,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "entries": {
          "type": "object",
          "minProperties": 69,
          "maxProperties": 69
        }
      },
      "additionalProperties": false
    },
    "implementationEnums": {
      "type": "object",
      "required": [
        "schema_version",
        "owner_decision",
        "component_classes",
        "component_types",
        "roles",
        "capabilities",
        "operational_statuses",
        "relationship_types",
        "retention_bases",
        "change_modes",
        "custody_values",
        "information_classifications",
        "disclosure_rules",
        "disclosure_boundaries",
        "source_binding_bases",
        "verification_methods",
        "migration_kinds",
        "coverage_treatments",
        "authority_source_types",
        "authority_effects"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "owner_decision": {
          "type": "object"
        },
        "component_classes": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "component_types": {
          "$ref": "#/$defs/nestedEnumDefinitions"
        },
        "roles": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "capabilities": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "operational_statuses": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "relationship_types": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "retention_bases": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "change_modes": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "custody_values": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "information_classifications": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "disclosure_rules": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "disclosure_boundaries": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "source_binding_bases": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "verification_methods": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "migration_kinds": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "coverage_treatments": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "authority_source_types": {
          "$ref": "#/$defs/enumDefinitions"
        },
        "authority_effects": {
          "$ref": "#/$defs/enumDefinitions"
        }
      },
      "additionalProperties": false
    },
    "enumDefinitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "nestedEnumDefinitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/enumDefinitions"
      }
    }
  }
}
