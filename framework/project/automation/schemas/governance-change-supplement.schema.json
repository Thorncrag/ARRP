{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARRP owner-local governance change supplement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_class",
    "governance_id",
    "public_entry_sha256",
    "recorded_at",
    "provenance",
    "decision_context",
    "protected_references",
    "validation_references",
    "disclosure_review",
    "safe_summary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^GOVSUP-[0-9]{4}-[0-9]{3}$"},
    "event_class": {"const": "governance_change_supplement"},
    "governance_id": {"type": "string", "pattern": "^GOV-[0-9]{4}-[0-9]{3}$"},
    "public_entry_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "string", "minLength": 1},
    "decision_context": {"type": "string", "minLength": 1},
    "protected_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validation_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "disclosure_review": {"const": "owner_local_only"},
    "safe_summary": {"type": "string", "minLength": 1}
  }
}
