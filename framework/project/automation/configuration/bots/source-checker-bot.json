{
  "agentId": "source-checker-bot",
  "enabled": true,
  "mode": "report-only",
  "deploymentStatus": "local-first-enabled",
  "localStage": {
    "coordinator": "scripts/arrp_nightly.py",
    "dueEveryHours": 168,
    "outputRoot": "<run-dir>/stages/source-checker-bot",
    "publication": false,
    "remoteMutation": false
  },
  "catalogs": [
    "inventory/sources.csv",
    "inventory/sources-pending.csv"
  ],
  "urlField": "URL",
  "idField": "Source ID",
  "titleField": "Title or Description",
  "publisherField": "Authority / Publisher",
  "request": {
    "timeoutSeconds": 20,
    "retries": 2,
    "backoffSeconds": 1.0,
    "minimumDomainIntervalSeconds": 0.15,
    "workers": 8,
    "maximumBytes": 262144
  },
  "historyLimit": 12,
  "currentReport": "framework/status/sources/source-checker-report.md",
  "currentData": "<run-dir>/stages/source-checker-bot/source-checker.json",
  "priorData": "<last-success>/source-checker-bot/source-checker.json"
}
