{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARRP owner-local project-wide reconciliation disposition ledger",
  "type": "object",
  "required": ["schema_version", "ledger_id", "reviewed_at", "local_snapshot_digest", "retained_states"],
  "properties": {
    "schema_version": {"const": 1},
    "ledger_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "local_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "retained_states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "identity_binding", "disposition", "evidence_refs", "reviewed_at", "next_action", "reconciliation_eligible"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "identity_binding": {"type": "object", "required": ["sha256"], "properties": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
          "disposition": {"enum": ["retained_closed_request", "retained_historical", "retained_superseded", "retained_fixture", "retained_failed_transaction", "pending_human_review"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reviewed_at": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1},
          "reconciliation_eligible": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
