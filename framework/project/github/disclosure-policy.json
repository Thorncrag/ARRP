{
  "schema_version": 1,
  "policy_id": "arrp-github-disclosure-v2",
  "control_pack_contract": {
    "schema_version": 1,
    "required": true,
    "compatible_control_versions": ["2026-07-28.1"],
    "active_pointer": "disclosure-control-packs/active.json"
  },
  "artifact_group_patterns": [
    "compiled-public-pdf:*",
    "console-generation:*",
    "public-site-generation",
    "pull-request:*",
    "generated-document-family"
  ],
  "categories": [
    "public_by_design",
    "public_operational_summary",
    "restricted_operational",
    "private",
    "prohibited_secret"
  ],
  "public_categories": [
    "public_by_design",
    "public_operational_summary"
  ],
  "artifact_families": [
    {
      "id": "public-project-entry",
      "category": "public_by_design",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github", "public-release-builder"],
      "paths": ["README.md", "ABOUT.md", "PRINT_READERS_GUIDE.md", "SUBJECT_INDEX.md", "UNDER_REVIEW.md", "SUPPORT.md", "CONTRIBUTING.md", "LICENSE", "LICENSE.md", "CITATION.cff", "mkdocs.yml"]
    },
    {
      "id": "public-research-and-proposals",
      "category": "public_by_design",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github", "public-release-builder"],
      "paths": ["areas/**", "legislation/**", "topics/**", "research/**", "framework/proposals/**"],
      "exclude_paths": ["framework/project/interfaces/project-console/**"]
    },
    {
      "id": "public-project-report",
      "category": "public_by_design",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github", "public-release-builder"],
      "paths": ["framework/reports/**"]
    },
    {
      "id": "public-source-and-workflow-records",
      "category": "public_by_design",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": ["inventory/**", "framework/logs/audits/**", "framework/logs/candidates/**", "framework/logs/sources/**"]
    },
    {
      "id": "public-methodology",
      "category": "public_by_design",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": ["framework/standards/audits/**", "framework/standards/content/**", "framework/standards/sources/**", "framework/standards/publication/**", "framework/project/workflows/**", "framework/project/publication/**", "framework/project/profile/**", "framework/project/github/workflow.md"]
    },
    {
      "id": "public-governance-summary",
      "category": "public_operational_summary",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": ["framework/FRAMEWORK.md", "framework/PROJECT_STRUCTURE.md", "framework/archive/authorities/PROJECT_STRUCTURE.md", "framework/component-registry.json", "framework/component-registry.schema.json", "framework/receipts/component-registry/**", "framework/standards/README.md", "framework/standards/interfaces/**", "framework/project/README.md", "framework/project/PROJECT_PROFILE.md", "framework/project/REPOSITORY_MAP.md", "framework/archive/authorities/REPOSITORY_MAP.md", "framework/project/interfaces/**", "framework/archive/operational/**", "framework/archive/baselines/**", "framework/logs/governance/**", "framework/status/**"],
      "exclude_paths": ["framework/project/interfaces/project-console/**"]
    },
    {
      "id": "public-participation",
      "category": "public_by_design",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github", "console-public-bundle"],
      "paths": ["participate/**", ".github/ISSUE_TEMPLATE/**", ".github/PULL_REQUEST_TEMPLATE.md"],
      "exclude_paths": ["participate/.env", "participate/.env.*"]
    },
    {
      "id": "public-empty-environment-template",
      "category": "public_operational_summary",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": ["participate/.env.example"]
    },
    {
      "id": "public-interface-assets",
      "category": "public_operational_summary",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github", "console-public-bundle", "public-release-builder"],
      "paths": ["website/**", "assets/branding/**", "framework/project/interfaces/project-console/**"],
      "exclude_paths": ["framework/project/interfaces/project-console/data/private-*.js", "framework/project/interfaces/project-console/prototypes/**"]
    },
    {
      "id": "public-release-artifacts",
      "category": "public_by_design",
      "producers": ["public-release-builder", "arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": ["exports/public/**", "exports/pdf/**", "site/**"]
    },
    {
      "id": "public-source-archives",
      "category": "public_by_design",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": ["sources/**"]
    },
    {
      "id": "portable-repository-administration",
      "category": "public_operational_summary",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": [".gitattributes", ".gitignore", ".rgignore", ".github/CODEOWNERS", ".github/SECURITY.md", ".github/*.json", ".github/launchd/com.thorncrag.arrp-nightly.plist.example", "framework/project/automation/configuration/launchd/**", "requirements-*.txt", "exports/README.md", "framework/handoffs/**", "framework/project/github/disclosure-boundary.md", "framework/project/github/disclosure-policy.json"]
    },
    {
      "id": "portable-automation-and-controls",
      "category": "public_operational_summary",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": ["scripts/**", "tests/**", ".github/workflows/**", "framework/project/automation/**", "framework/archive/authorities/AGENT_BOT_REGISTRY.md", "framework/archive/authorities/context-routes.json", "framework/logs/automation/**", "framework/receipts/automation/**", "framework/receipts/disclosure/**", "framework/standards/automation/**", "AGENTS.md", "framework/AGENT_OPERATING_RULES.md", "framework/CONTEXT_ROUTING.md", "framework/archive/authorities/CONTEXT_ROUTING.md"],
      "exclude_paths": ["framework/project/automation/configuration/launchd/**"]
    },
    {
      "id": "restricted-console-prototypes",
      "category": "restricted_operational",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": ["framework/project/interfaces/project-console/prototypes/**"]
    },
    {
      "id": "private-local-state",
      "category": "private",
      "producers": ["arrp-nightly-publication", "interactive-reviewed-github"],
      "paths": ["**/.env", "**/.env.*", "**/PAUSED", "**/governance-change-supplements.jsonl", "**/operational-incidents.jsonl", "**/security-incidents.jsonl", "**/incident-relations.jsonl", "data/private-*.js", "framework/project/interfaces/project-console/data/private-*.js"],
      "exclude_paths": ["participate/.env.example"]
    },
    {
      "id": "github-pull-request-text",
      "category": "public_operational_summary",
      "producers": ["arrp-nightly-pull-request", "interactive-reviewed-github"],
      "paths": ["github/pull-request/**"]
    },
    {
      "id": "github-issue-text",
      "category": "public_by_design",
      "producers": ["arrp-semantic-broker", "interactive-reviewed-github"],
      "paths": ["github/issue/**"]
    },
    {
      "id": "github-discussion-text",
      "category": "public_by_design",
      "producers": ["arrp-semantic-broker", "interactive-reviewed-github"],
      "paths": ["github/discussion/**"]
    },
    {
      "id": "github-project-field-text",
      "category": "public_operational_summary",
      "producers": ["arrp-semantic-broker", "interactive-reviewed-github"],
      "paths": ["github/project-field/**"]
    },
    {
      "id": "github-release-text",
      "category": "public_by_design",
      "producers": ["public-release-builder", "interactive-reviewed-github"],
      "paths": ["github/release/**"]
    },
    {
      "id": "github-branch-ref-delete-control",
      "category": "public_operational_summary",
      "producers": ["interactive-reviewed-github"],
      "paths": ["github/control/branch-ref-delete"]
    },
    {
      "id": "github-control-payload",
      "category": "public_operational_summary",
      "producers": ["arrp-nightly-publication", "arrp-semantic-broker"],
      "paths": ["github/control/**"]
    }
  ],
  "exceptional_overrides": [],
  "historical_disclosures": [
    {
      "id": "DISCLOSURE-HIST-001",
      "artifact_family": "agent-automation-technical-specification",
      "status": "removed_from_current_tree_but_retained_in_git_history",
      "note": "Motivating prior disclosure. Markdown, generated PDF, content-bearing generator, and tests are one artifact family. No history rewrite or external containment is authorized by this record."
    }
  ]
}
